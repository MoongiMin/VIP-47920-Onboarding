<mujoco model="dog">
  <compiler angle="degree"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <default>
    <geom type="box" size="0.05 0.05 0.05" density="700" rgba="0.55 0.35 0.15 1"/>
    <joint limited="true" range="-90 90" damping="2.5" stiffness="0.5"/>
    <motor ctrllimited="true" ctrlrange="-20 20"/>
  </default>

  <worldbody>
    <!-- Torso 6x6x40 cm laid down: long axis Y (0.03 0.20 0.03); lowered for stability -->
    <body name="torso" pos="0 0 0.25">
      <freejoint name="root_free"/>
      <inertial pos="0 0 -0.03" mass="3.0" diaginertia="0.1 0.15 0.1"/>
      <geom name="torso_geom" type="box" size="0.03 0.20 0.03" pos="0 0 0" rgba="0.55 0.35 0.15 1"/>

      <!-- Hip: left-right swing (axis Y); Knee: front-back bend (axis X) -->
      <body name="leg_fl" pos="0.05 0.20 0">
        <joint name="j_fl_hip" type="hinge" axis="0 1 0" pos="0 0 0"/>
        <inertial pos="0 0 -0.02" mass="0.5" diaginertia="0.002 0.003 0.002"/>
        <geom name="leg_fl_upper_geom" type="box" size="0.02 0.05 0.02" pos="0 0 -0.02" rgba="0.55 0.35 0.15 1"/>
        <body name="leg_fl_lower" pos="0.03 0 -0.02">
          <joint name="j_fl_knee" type="hinge" axis="1 0 0" pos="0 0 0"/>
          <inertial pos="0 0 -0.05" mass="0.35" diaginertia="0.003 0.003 0.001"/>
          <geom name="leg_fl_lower_geom" type="box" size="0.01 0.01 0.05" pos="0 0 -0.05" rgba="0.55 0.35 0.15 1"/>
          <!-- Ankle: 3rd segment 2x2x10 + sphere foot -->
          <body name="leg_fl_ankle" pos="-0.02 0 -0.10">
            <joint name="j_fl_ankle" type="hinge" axis="1 0 0" pos="0 0 0"/>
            <inertial pos="0 0 -0.06" mass="0.25" diaginertia="0.002 0.002 0.0005"/>
            <geom name="leg_fl_ankle_geom" type="box" size="0.01 0.01 0.05" pos="0 0 -0.05" rgba="0.55 0.35 0.15 1"/>
            <geom name="leg_fl_foot" type="sphere" size="0.02" pos="0 0 -0.12" rgba="0.55 0.35 0.15 1"/>
          </body>
        </body>
      </body>
      <body name="leg_fr" pos="-0.05 0.20 0">
        <joint name="j_fr_hip" type="hinge" axis="0 1 0" pos="0 0 0"/>
        <inertial pos="0 0 -0.02" mass="0.5" diaginertia="0.002 0.003 0.002"/>
        <geom name="leg_fr_upper_geom" type="box" size="0.02 0.05 0.02" pos="0 0 -0.02" rgba="0.55 0.35 0.15 1"/>
        <body name="leg_fr_lower" pos="-0.03 0 -0.02">
          <joint name="j_fr_knee" type="hinge" axis="1 0 0" pos="0 0 0"/>
          <inertial pos="0 0 -0.05" mass="0.35" diaginertia="0.003 0.003 0.001"/>
          <geom name="leg_fr_lower_geom" type="box" size="0.01 0.01 0.05" pos="0 0 -0.05" rgba="0.55 0.35 0.15 1"/>
          <body name="leg_fr_ankle" pos="0.02 0 -0.10">
            <joint name="j_fr_ankle" type="hinge" axis="1 0 0" pos="0 0 0"/>
            <inertial pos="0 0 -0.06" mass="0.25" diaginertia="0.002 0.002 0.0005"/>
            <geom name="leg_fr_ankle_geom" type="box" size="0.01 0.01 0.05" pos="0 0 -0.05" rgba="0.55 0.35 0.15 1"/>
            <geom name="leg_fr_foot" type="sphere" size="0.02" pos="0 0 -0.12" rgba="0.55 0.35 0.15 1"/>
          </body>
        </body>
      </body>
      <body name="leg_rl" pos="-0.05 -0.20 0">
        <joint name="j_rl_hip" type="hinge" axis="0 1 0" pos="0 0 0"/>
        <inertial pos="0 0 -0.02" mass="0.5" diaginertia="0.002 0.003 0.002"/>
        <geom name="leg_rl_upper_geom" type="box" size="0.02 0.05 0.02" pos="0 0 -0.02" rgba="0.55 0.35 0.15 1"/>
        <body name="leg_rl_lower" pos="-0.03 0 -0.02">
          <joint name="j_rl_knee" type="hinge" axis="1 0 0" pos="0 0 0"/>
          <inertial pos="0 0 -0.05" mass="0.35" diaginertia="0.003 0.003 0.001"/>
          <geom name="leg_rl_lower_geom" type="box" size="0.01 0.01 0.05" pos="0 0 -0.05" rgba="0.55 0.35 0.15 1"/>
          <body name="leg_rl_ankle" pos="0.02 0 -0.10">
            <joint name="j_rl_ankle" type="hinge" axis="1 0 0" pos="0 0 0"/>
            <inertial pos="0 0 -0.06" mass="0.25" diaginertia="0.002 0.002 0.0005"/>
            <geom name="leg_rl_ankle_geom" type="box" size="0.01 0.01 0.05" pos="0 0 -0.05" rgba="0.55 0.35 0.15 1"/>
            <geom name="leg_rl_foot" type="sphere" size="0.02" pos="0 0 -0.12" rgba="0.55 0.35 0.15 1"/>
          </body>
        </body>
      </body>
      <body name="leg_rr" pos="0.05 -0.20 0">
        <joint name="j_rr_hip" type="hinge" axis="0 1 0" pos="0 0 0"/>
        <inertial pos="0 0 -0.02" mass="0.5" diaginertia="0.002 0.003 0.002"/>
        <geom name="leg_rr_upper_geom" type="box" size="0.02 0.05 0.02" pos="0 0 -0.02" rgba="0.55 0.35 0.15 1"/>
        <body name="leg_rr_lower" pos="0.03 0 -0.02">
          <joint name="j_rr_knee" type="hinge" axis="1 0 0" pos="0 0 0"/>
          <inertial pos="0 0 -0.05" mass="0.35" diaginertia="0.003 0.003 0.001"/>
          <geom name="leg_rr_lower_geom" type="box" size="0.01 0.01 0.05" pos="0 0 -0.05" rgba="0.55 0.35 0.15 1"/>
          <body name="leg_rr_ankle" pos="-0.02 0 -0.10">
            <joint name="j_rr_ankle" type="hinge" axis="1 0 0" pos="0 0 0"/>
            <inertial pos="0 0 -0.06" mass="0.25" diaginertia="0.002 0.002 0.0005"/>
            <geom name="leg_rr_ankle_geom" type="box" size="0.01 0.01 0.05" pos="0 0 -0.05" rgba="0.55 0.35 0.15 1"/>
            <geom name="leg_rr_foot" type="sphere" size="0.02" pos="0 0 -0.12" rgba="0.55 0.35 0.15 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="m_fl_hip" joint="j_fl_hip"/>
    <motor name="m_fl_knee" joint="j_fl_knee"/>
    <motor name="m_fl_ankle" joint="j_fl_ankle"/>
    <motor name="m_fr_hip" joint="j_fr_hip"/>
    <motor name="m_fr_knee" joint="j_fr_knee"/>
    <motor name="m_fr_ankle" joint="j_fr_ankle"/>
    <motor name="m_rl_hip" joint="j_rl_hip"/>
    <motor name="m_rl_knee" joint="j_rl_knee"/>
    <motor name="m_rl_ankle" joint="j_rl_ankle"/>
    <motor name="m_rr_hip" joint="j_rr_hip"/>
    <motor name="m_rr_knee" joint="j_rr_knee"/>
    <motor name="m_rr_ankle" joint="j_rr_ankle"/>
  </actuator>
</mujoco>
