<mujoco model="dog">
  <compiler angle="degree"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>

  <default>
    <geom type="box" size="0.05 0.05 0.05" density="500" rgba="0.55 0.35 0.15 1"/>
  </default>

  <worldbody>
    <!-- Torso 6x6x40 cm laid down: long axis Y (0.03 0.20 0.03); bottom face z=-0.03 -->
    <body name="torso" pos="0 0 0.25">
      <freejoint name="root_free"/>
      <geom name="torso_geom" type="box" size="0.03 0.20 0.03" pos="0 0 0" rgba="0.55 0.35 0.15 1"/>

      <!-- Legs 4x10x4 on side faces (옆면): x=±0.03, front/rear at y=±0.20, z=0 -->
      <body name="leg_fl" pos="0.05 0.20 0">
        <geom name="leg_fl_geom" type="box" size="0.02 0.05 0.02" pos="0 0 -0.02" rgba="0.55 0.35 0.15 1"/>
      </body>
      <body name="leg_fr" pos="-0.05 0.20 0">
        <geom name="leg_fr_geom" type="box" size="0.02 0.05 0.02" pos="0 0 -0.02" rgba="0.55 0.35 0.15 1"/>
      </body>
      <body name="leg_rl" pos="-0.05 -0.20 0">
        <geom name="leg_rl_geom" type="box" size="0.02 0.05 0.02" pos="0 0 -0.02" rgba="0.55 0.35 0.15 1"/>
      </body>
      <body name="leg_rr" pos="0.05 -0.20 0">
        <geom name="leg_rr_geom" type="box" size="0.02 0.05 0.02" pos="0 0 -0.02" rgba="0.55 0.35 0.15 1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
